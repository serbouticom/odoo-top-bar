<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Formulaire Backend -->
    <record id="view_announcement_bar_form" model="ir.ui.view">
        <field name="name">medamine.announcement.form</field>
        <field name="model">medamine.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcement Bar">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Announcement title..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Display">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_closable" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="website_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="message" widget="html" colspan="2"/>
                    </group>
                    <group string="Style">
                        <group>
                            <field name="bg_color" widget="color"/>
                            <field name="text_color" widget="color"/>
                        </group>
                        <group>
                            <field name="link_url" placeholder="https://..."/>
                            <field name="link_label"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste Backend -->
    <record id="view_announcement_bar_tree" model="ir.ui.view">
        <field name="name">medamine.announcement.tree</field>
        <field name="model">medamine.announcement</field>
        <field name="arch" type="xml">
            <tree string="Announcement Bars" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_closable"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="view_announcement_bar_search" model="ir.ui.view">
        <field name="name">medamine.announcement.search</field>
        <field name="model">medamine.announcement</field>
        <field name="arch" type="xml">
            <search string="Search Announcements">
                <field name="name"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Website" name="group_website" context="{'group_by': 'website_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_announcement_bar" model="ir.actions.act_window">
        <field name="name">Announcement Bars</field>
        <field name="res_model">medamine.announcement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_announcement_bar_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Announcement Bar
            </p>
            <p>
                Announcement bars appear at the top of your website to highlight
                promotions, news, or important messages.
            </p>
        </field>
    </record>

    <!-- Menu principal (top-level) -->
    <menuitem id="menu_announcement_bar_root"
              name="Announcement Bar"
              sequence="99"
              web_icon="medamine,static/description/icon.png"/>

    <!-- Sous-menu -->
    <menuitem id="menu_announcement_bar_list"
              name="Announcement Bars"
              parent="menu_announcement_bar_root"
              action="action_announcement_bar"
              sequence="10"/>

    <!-- Menu: accessible depuis Website > Configuration -->
    <menuitem id="menu_announcement_bar_website"
              name="Announcement Bar"
              parent="website.menu_website_global_configuration"
              action="action_announcement_bar"
              sequence="50"/>

</odoo>
